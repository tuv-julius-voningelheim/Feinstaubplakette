{
  "name": "@tuvsud/design-system",
  "version": "1.30.2",
  "release": true,
  "description": "TÜV SÜD Algorithm Design System",
  "author": {
    "name": "Feras Ahmad",
    "email": "feras.ahmad@tuvsud.com"
  },
  "repository": {
    "url": "https://dev.azure.com/tuvsud01/ALGORITHM%20Design%20System/_git/design-system"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/entry.js",
      "types": "./dist/entry.d.ts"
    },
    "./*": {
      "import": "./dist/components/*/index.js",
      "types": "./dist/components/*/index.d.ts"
    },
    "./react": {
      "import": "./dist/entry-react.js",
      "types": "./dist/entry-react.d.ts"
    },
    "./react/*": {
      "import": "./dist/components/*/react/index.js",
      "types": "./dist/components/*/react/index.d.ts"
    },
    "./icon-libraries": {
      "import": "./dist/utils/icon/register-google-material.js",
      "types": "./dist/utils/icon/register-google-material.d.ts"
    },
    "./vite": {
      "import": "./dist/utils/icon/vite-plugin.js",
      "types": "./dist/utils/icon/vite-plugin.d.ts"
    },
    "./webpack": {
      "import": "./dist/utils/icon/webpack-plugin.js",
      "types": "./dist/utils/icon/webpack-plugin.d.ts"
    },
    "./tokens/css/dark.css": "./dist/tokens/bundle-dark.css",
    "./tokens/css/light.css": "./dist/tokens/bundle-light.css",
    "./theme/fonts.css": "./dist/theme/fonts.css"
  },
  "files": [
    "dist",
    "fonts/",
    "theme/fonts.css"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "compile": "tsc -p tsconfig.declarations.json",
    "bundle": "rollup -c rollup.config.js --silent",
    "copy:fonts": "cpy \"public/fonts/*.{woff,woff2}\" \"dist/fonts\"",
    "copy:fonts-css": "cpy \"theme/fonts.css\" \"dist/\"",
    "build:tokens": "tsx scripts/build-css-tokens.ts --verbose",
    "make:figma-mirror": "tsx scripts/make-figma-mirror.ts",
    "build:figma": "npm run build && npm run make:figma-mirror",
    "build": "npm run compile && npm run bundle && npm run copy:fonts-css && npm run build:tokens && npm run copy:fonts",
    "lint": "run-p lint:*",
    "lint:eslint": "eslint . --cache --cache-location .cache/eslint",
    "lint:prettier": "prettier . --check --ignore-unknown",
    "format": "run-s format:eslint format:prettier",
    "format:eslint": "eslint . --fix --cache --cache-location .cache/eslint",
    "format:prettier": "prettier . --write --ignore-unknown",
    "prettier:check": "prettier . --check --ignore-unknown",
    "prettier:fix": "prettier . --write --ignore-unknown",
    "storybook": "npm run build:tokens && npm run copy:fonts-css && storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build",
    "release": "npm run build && changeset publish",
    "version": "changeset version && npm i",
    "prepare": "npm run build",
    "chromatic": "npx chromatic --project-token=chpt_1f44909924e5c27",
    "chromatic-deploy": "npx chromatic --project-token=chpt_1f44909924e5c27 --only-storybook",
    "test": "web-test-runner --config web-test-runner.config.mjs --group default",
    "test:watch": "web-test-runner --watch --config web-test-runner.config.mjs --group default",
    "test:coverage": "web-test-runner --coverage --config web-test-runner.config.mjs --group default",
    "spellcheck": "npx cspell .",
    "verify": "npm run lint && npm run test",
    "test-one": "npm run test components/table/*.test.ts",
    "test-utils": "npm run test utils/internal/test/form-control-base.tests.ts",
    "analyze:sizes": "node scripts/analyze-sizes.js",
    "analyze:component-sizes": "node performance/component-size.js"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@lit/react": "^1.0.8",
    "@shoelace-style/animations": "^1.2.0",
    "@shoelace-style/localize": "^3.2.2",
    "colorjs.io": "^0.6.1",
    "composed-offset-position": "^0.0.6",
    "ibantools": "^4.5.4",
    "lit": "^3.3.3",
    "luxon": "^3.7.2",
    "qr-creator": "^1.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/js": "^10.0.1",
    "@github-ui/storybook-addon-performance-panel": "^1.1.4",
    "@lit-labs/rollup-plugin-minify-html-literals": "^0.2.0",
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/builder-vite": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/web-components": "^10.4.6",
    "@storybook/web-components-vite": "^10.4.6",
    "@types/luxon": "^3.7.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-coverage-v8": "^0.8.0",
    "@web/test-runner-playwright": "^0.11.1",
    "chai": "^6.2.2",
    "chromatic": "^18.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "cpy": "^13.2.2",
    "cpy-cli": "^7.0.0",
    "cspell": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-mocha": "^11.3.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-wc": "^3.1.0",
    "filesize": "^11.0.19",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "globby": "^16.2.1",
    "http-server": "^14.1.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "npm-run-all2": "^9.0.2",
    "playwright": "^1.61.1",
    "prettier": "^3.9.4",
    "rollup": "^4.62.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "sinon": "^22.0.0",
    "storybook": "^10.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "webpack": "^5.108.4"
  },
  "peerDependencies": {
    "copy-webpack-plugin": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "copy-webpack-plugin": {
      "optional": true
    }
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "react",
    "angular",
    "typescript",
    "storybook",
    "a11y"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "customElements": "custom-elements.json",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "serialize-javascript": "^7.0.5",
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
